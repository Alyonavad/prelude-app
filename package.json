    "deploy:gh-pages": "vite build && npx gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
